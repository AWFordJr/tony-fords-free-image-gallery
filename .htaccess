# Tony Ford's Free Image Gallery - by Anthony W. Ford, Jr. (Tony Ford) - awfordjr@gmail.com
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Block direct access to code folders
  RewriteRule ^(inc|pages)(/|$) - [F,L]
  RewriteRule ^(config\.php\.bak|README\.md|\.git) - [F,L]
  # Pretty URLs: send everything that is not a real file to the front controller
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)$ index.php?r=$1 [QSA,L]
</IfModule>

<FilesMatch "^(config\.php|schema\.php)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# index.php and install.php are the only PHP entry points that may be requested directly
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
</IfModule>
